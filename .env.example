# Copie para .env (NUNCA faça commit do .env)
# cp .env.example .env

# Chave AES-128 do robô: 32 caracteres hexadecimais.
UNITREE_AES_KEY=
# Firmware Go2 < 1.1.15 não usa chave: defina 0.
# UNITREE_REQUIRE_AES=1

# LocalAP (padrão) | LocalSTA | Remote
UNITREE_METHOD=LocalAP

# Opcionais
# UNITREE_IP=192.168.12.1
# UNITREE_SN=
# UNITREE_REGION=global
# UNITREE_DEVICE=Go2
